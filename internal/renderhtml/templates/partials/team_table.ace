{{if .Rows}}
section.panel
  .section-heading
    div
      h2.section-title {{.Title}}
      {{if .Note}}
      p.section-note {{.Note}}
      {{end}}
    {{if .ViewAllHref}}
    a.section-link href="{{.ViewAllHref}}" View All
    {{end}}
  .table-wrap
    table.data-table
      thead
        tr
          th Team
          th K
          th D
          th A
          th TK
          th R
      tbody
        {{range .Rows}}
        tr
          td
            a.entity-link href="{{.Href}}" {{.Name}}
          td {{.Kills}}
          td {{.Deaths}}
          td {{.Assists}}
          td {{.Teamkills}}
          td {{.Ratio}}
        {{end}}
{{end}}
