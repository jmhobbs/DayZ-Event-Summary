= doctype html
html lang=en
  head
    meta charset=utf-8
    meta name=viewport content="width=device-width, initial-scale=1"
    title {{.Title}}
    link rel=stylesheet href="{{.AssetHref}}"
  body
    = include partials/site_header .
    main.shell.page-shell
      = yield body
    = include partials/site_footer .
